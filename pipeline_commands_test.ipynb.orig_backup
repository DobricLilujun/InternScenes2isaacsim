      "[OK] scripts/topdown_projection.py: /home/ubadmin/projects/InternScenes2isaacsim/scripts/topdown_projection.py\n",
      "[OK] scene0001_00 glb: /home/ubadmin/projects/InternScenes2isaacsim/output/composed/scannet/scene0001_00/glb_scene.glb\n"
     ]
    }
   ],
   "source": [
    "import os\n",
    "\n",
    "PROJ = \"/home/ubadmin/projects/InternScenes2isaacsim\"\n",
    "BLENDER = \"/home/ubadmin/tools/blender/blender-5.1.2-linux-x64/blender\"\n",
    "VENV_PY = os.path.join(PROJ, \".venv311/bin/python\")\n",
    "\n",
    "checks = {\n",
    "    \"project root\": PROJ,\n",
    "    \"venv311 python\": VENV_PY,\n",
    "    \"blender binary\": BLENDER,\n",
    "    \"scripts/glb_to_usd.py\": os.path.join(PROJ, \"scripts/glb_to_usd.py\"),\n",
    "    \"scripts/usd_all.sh\": os.path.join(PROJ, \"scripts/usd_all.sh\"),\n",
    "    \"scripts/glb_render.py\": os.path.join(PROJ, \"scripts/glb_render.py\"),\n",
    "    \"scripts/topdown_projection.py\": os.path.join(PROJ, \"scripts/topdown_projection.py\"),\n",
    "    \"scene0001_00 glb\": os.path.join(PROJ, \"output/composed/scannet/scene0001_00/glb_scene.glb\"),\n",
    "}\n",
    "\n",
    "for label, path in checks.items():\n",
    "    status = \"OK\" if os.path.exists(path) else \"MISSING\"\n",
    "    print(f\"[{status}] {label}: {path}\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. 单场景转 USD（GLB → USD）\n",
    "\n",
    "**命令：**\n",
    "\n",
    "```bash\n",
    "cd /home/ubadmin/projects/InternScenes2isaacsim\n",
    ".venv311/bin/python scripts/glb_to_usd.py \\\n",
    "  --glb output/composed/scannet/scene0001_00/glb_scene.glb \\\n",
    "  --out output/usd/scannet/scene0001_00/scene.usd\n",
    "```\n",
    "\n",
    "**原理：**\n",
    "\n",
    "1. `trimesh.load(glb)` 把 GLB 场景解析成 trimesh 的场景图（每个物体一个几何体 + 变换矩阵）。\n",
    "2. 用 `pxr.Usd.Stage` 创建一个新的 USD Stage，并按物体逐一在 `/Objects/xform_*/mesh` 下建立层级：\n",
    "   - `Mesh`：写入顶点、面片等拓扑数据\n",
    "   - `Xform`：写入这个物体在世界坐标系下的变换矩阵（位置、旋转、缩放）\n",
    "   - `Shader`：写入 BaseColor，把 GLB 的材质颜色带到 USD 里\n",
    "3. 最后调用 `stage.Export(usd)` 把整个 Stage 写成 `.usd` 文件。\n",
    "\n",
    "**输出：** `output/usd/<scene>/scene.usd`，里面包含材质和世界变换，可以被 Isaac Sim / usdview 等直接打开。\n",
    "\n",
    "下面这个单元会**真实执行**这条命令，并检查输出文件是否成功生成。\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "运行命令: /home/ubadmin/projects/InternScenes2isaacsim/.venv311/bin/python scripts/glb_to_usd.py --glb output/composed/scannet/scene0001_00/glb_scene.glb --out output/usd/scannet/scene0001_00/scene.usd\n",
      "--- stdout ---\n",
      "meshes: 929 USD size: 6149526\n",
      "USD written: output/usd/scannet/scene0001_00/scene.usd\n",
      "exit_code: 0\n",
      "\n",
      "✅ 生成成功: /home/ubadmin/projects/InternScenes2isaacsim/output/usd/scannet/scene0001_00/scene.usd (6005.4 KB)\n"
     ]
    }
   ],
   "source": [
    "import subprocess, os\n",
    "\n",
    "glb = \"output/composed/scannet/scene0001_00/glb_scene.glb\"\n",
    "usd_out = \"output/usd/scannet/scene0001_00/scene.usd\"\n",
    "\n",
    "cmd = [VENV_PY, \"scripts/glb_to_usd.py\", \"--glb\", glb, \"--out\", usd_out]\n",
    "print(\"运行命令:\", \" \".join(cmd))\n",
    "\n",
    "proc = subprocess.run(cmd, cwd=PROJ, capture_output=True, text=True, timeout=120)\n",
    "print(\"--- stdout ---\")\n",
    "print(proc.stdout.strip())\n",
    "if proc.returncode != 0:\n",
    "    print(\"--- stderr ---\")\n",
    "    print(proc.stderr.strip())\n",
    "print(\"exit_code:\", proc.returncode)\n",
    "\n",
    "usd_path = os.path.join(PROJ, usd_out)\n",
    "if os.path.exists(usd_path):\n",
    "    size_kb = os.path.getsize(usd_path) / 1024\n",
    "    print(f\"\\n✅ 生成成功: {usd_path} ({size_kb:.1f} KB)\")\n",
    "else:\n",
    "    print(f\"\\n❌ 未找到输出文件: {usd_path}\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. 批量转 USD（5 个场景）\n",
    "\n",
    "**命令：**\n",
    "\n",
    "```bash\n",
    "cd /home/ubadmin/projects/InternScenes2isaacsim\n",
    "bash scripts/usd_all.sh\n",
    "```\n",
    "\n",
    "**原理：** `scripts/usd_all.sh` 内部就是一个 for 循环，对固定的 5 个场景（3rscan / arkitscenes / scannet ×2 / matterport3d）依次调用第 1 节里同样的 `glb_to_usd.py`，本质是同一条命令跑 5 遍：\n",
    "\n",
    "```bash\n",
    "for scene in \"${SCENES[@]}\"; do\n",
    "  .venv311/bin/python scripts/glb_to_usd.py --glb=\"output/composed/$scene/glb_scene.glb\" --out=\"output/usd/$scene/scene.usd\"\n",
    "done\n",
    "```\n",
    "\n",
    "**输出：** `output/usd/<scene>/scene.usd` × 5。\n",
    "\n",
    "下面会**真实批量执行**这个脚本（单场景约 10 秒左右，5 个场景预计 1 分钟内完成），并逐一检查每个场景的 USD 是否生成。\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "=== USD 3rscan/095821fb-e2c2-2de1-94df-20f2cb423bcb ===\n",
      "  meshes: 89 USD size: 1653837\n",
      "USD written: output/usd/3rscan/095821fb-e2c2-2de1-94df-20f2cb423bcb/scene.usd\n",
      "=== USD arkitscenes/Training/43896449 ===\n",
      "  meshes: 1394 USD size: 11826230\n",
      "USD written: output/usd/arkitscenes/Training/43896449/scene.usd\n",
      "=== USD scannet/scene0001_00 ===\n",
      "  meshes: 929 USD size: 6149526\n",
      "USD written: output/usd/scannet/scene0001_00/scene.usd\n",
      "=== USD scannet/scene0000_00 ===\n",
      "  meshes: 3039 USD size: 27277074\n",
      "USD written: output/usd/scannet/scene0000_00/scene.usd\n",
      "=== USD matterport3d/B6ByNegPMKs/region51 ===\n",
      "  meshes: 2283 USD size: 9865558\n",
      "USD written: output/usd/matterport3d/B6ByNegPMKs/region51/scene.usd\n",
      "ALL_USD_DONE\n",
      "\n",
      "exit_code: 0, elapsed: 47.5s\n",
      "\n",
      "逐场景校验:\n",
      "  [OK] 3rscan/095821fb-e2c2-2de1-94df-20f2cb423bcb\n",
      "  [OK] arkitscenes/Training/43896449\n",
      "  [OK] scannet/scene0001_00\n",
      "  [OK] scannet/scene0000_00\n",
      "  [OK] matterport3d/B6ByNegPMKs/region51\n"
     ]
    }
   ],
   "source": [
    "import subprocess, os, time\n",
    "\n",
    "SCENES = [\n",
    "    \"3rscan/095821fb-e2c2-2de1-94df-20f2cb423bcb\",\n",
    "    \"arkitscenes/Training/43896449\",\n",
    "    \"scannet/scene0001_00\",\n",
    "    \"scannet/scene0000_00\",\n",
    "    \"matterport3d/B6ByNegPMKs/region51\",\n",
    "]\n",
    "\n",
    "t0 = time.time()\n",
    "proc = subprocess.run([\"bash\", \"scripts/usd_all.sh\"], cwd=PROJ, capture_output=True, text=True, timeout=600)\n",
    "elapsed = time.time() - t0\n",
    "\n",
    "print(proc.stdout[-3000:])\n",
    "if proc.returncode != 0:\n",
    "    print(\"--- stderr ---\")\n",
    "    print(proc.stderr[-2000:])\n",
    "print(f\"exit_code: {proc.returncode}, elapsed: {elapsed:.1f}s\")\n",
    "\n",
    "print(\"\\n逐场景校验:\")\n",
    "for scene in SCENES:\n",
    "    p = os.path.join(PROJ, \"output/usd\", scene, \"scene.usd\")\n",
    "    status = \"OK\" if os.path.exists(p) else \"MISSING\"\n",
    "    print(f\"  [{status}] {scene}\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. 渲染路径 ①：Blender 渲染 GLB → 透视图 PNG\n",
    "\n",
    "**命令：**\n",
    "\n",
    "```bash\n",
    "cd /home/ubadmin/projects/InternScenes2isaacsim\n",
    "/home/ubadmin/tools/blender/blender-5.1.2-linux-x64/blender --background \\\n",
    "  --python scripts/glb_render.py -- \\\n",
    "  --glb output/composed/scannet/scene0001_00/glb_scene.glb \\\n",
    "  --out output/render/scannet/scene0001_00 --engine=EEVEE\n",
    "```\n",
    "\n",
    "**原理：**\n",
    "\n",
    "- `--background`：Blender 无界面模式启动（headless），适合服务器批量渲染。\n",
    "- `--python scripts/glb_render.py`：让 Blender 执行这个脚本，脚本内部会：\n",
    "  1. 用 Blender 自带的 glTF 导入器把 `--glb` 指定的场景导入进 Blender 场景\n",
    "  2. 在房间内部放一个相机（模拟第一人称/室内视角）\n",
    "  3. 用 `--engine` 指定的渲染引擎（这里是 EEVEE，实时渲染引擎，速度快、材质效果够用）渲染一张透视图\n",
    "  4. 把结果保存为 `<out>/perspective.png`\n",
    "\n",
    "这是三条渲染路径里**最稳定**的一条，因为它只依赖本机的 Blender，不需要额外的 GPU 集群或远程环境。\n",
    "\n",
    "下面会**真实执行**这条渲染命令（实测单场景约 8-10 秒），并显示渲染结果。\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "运行命令: /home/ubadmin/tools/blender/blender-5.1.2-linux-x64/blender --background --python scripts/glb_render.py -- --glb output/composed/scannet/scene0001_00/glb_scene.glb --out output/render/scannet/scene0001_00 --engine=EEVEE\n",
      "00:09.234  render           | Saved: 'output/render/scannet/scene0001_00/perspective.png'\n",
      "rendering with engine = BLENDER_EEVEE\n",
      "render saved: output/render/scannet/scene0001_00/perspective.png\n",
      "DONE\n",
      "exit_code: 0\n",
      "\n",
      "✅ 渲染成功: /home/ubadmin/projects/InternScenes2isaacsim/output/render/scannet/scene0001_00/perspective.png (2890.8 KB)\n"
     ]
    }
   ],
   "source": [
    "import subprocess, os\n",
    "\n",
    "cmd = [\n",
    "    BLENDER, \"--background\", \"--python\", \"scripts/glb_render.py\", \"--\",\n",
    "    \"--glb\", \"output/composed/scannet/scene0001_00/glb_scene.glb\",\n",
    "    \"--out\", \"output/render/scannet/scene0001_00\", \"--engine=EEVEE\",\n",
    "]\n",
    "print(\"运行命令:\", \" \".join(cmd))\n",
    "\n",
    "proc = subprocess.run(cmd, cwd=PROJ, capture_output=True, text=True, timeout=300)\n",
    "# Blender 日志很长，只保留和渲染结果相关的关键行\n",
    "for line in proc.stdout.splitlines():\n",
    "    if any(k in line for k in (\"render saved\", \"rendering\", \"DONE\", \"Error\", \"Saved\")):\n",
    "        print(line)\n",
    "print(\"exit_code:\", proc.returncode)\n",
    "\n",
    "png = os.path.join(PROJ, \"output/render/scannet/scene0001_00/perspective.png\")\n",
    "if os.path.exists(png):\n",
    "    print(f\"\\n✅ 渲染成功: {png} ({os.path.getsize(png)/1024:.1f} KB)\")\n",
    "else:\n",
    "    print(f\"\\n❌ 未找到渲染结果: {png}\")\n"
   ]
  },
