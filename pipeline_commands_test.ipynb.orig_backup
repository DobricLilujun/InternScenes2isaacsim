   "source": [
    "import os\n",
    "\n",
    "\n",
    "\n",
    "LAYOUT_DIR = os.path.join(PROJ, \"data\", \"Layout_info\")\n",
    "def scan_dataset(dataset_dir, dataset_name):\n",
    "\n",
    "    \"\"\"Walk a dataset dir and return every scene id (folder containing layout.json),\n",
    "\n",
    "    relative to the dataset root, in POSIX form (e.g. 'Training/43896449').\"\"\"\n",
    "\n",
    "    scene_ids = []\n",
    "\n",
    "    for root, dirs, files in os.walk(dataset_dir):\n",
    "\n",
    "        if \"layout.json\" in files:\n",
    "\n",
    "            rel = os.path.relpath(root, dataset_dir).replace(os.sep, \"/\")\n",
    "\n",
    "            scene_ids.append(rel)\n",
    "\n",
    "    scene_ids.sort()\n",
    "\n",
    "    return scene_ids\n",
    "\n",
    "\n",
    "DATASETS = [\"scannet\", \"3rscan\", \"arkitscenes\", \"matterport3d\"]\n",
    "\n",
    "inventory = {}\n",
    "\n",
    "for name in DATASETS:\n",
    "\n",
    "    d = os.path.join(LAYOUT_DIR, name)\n",
    "\n",
    "    inventory[name] = scan_dataset(d, name) if os.path.isdir(d) else []\n",
    "\n",
    "\n",
    "\n",
    "total = sum(len(v) for v in inventory.values())\n",
    "\n",
    "print(f\"InternScenes 场景总数: {total}\\n\")\n",
    "\n",
    "for name in DATASETS:\n",
    "\n",
    "    ids = inventory[name]\n",
    "\n",
    "    print(f\"=== {name}  (共 {len(ids)} 个场景) ===\")\n",
    "\n",
    "    for sid in ids[:20]:\n",
    "\n",
    "        print(\"  \", sid)\n",
    "\n",
    "    if len(ids) > 20:\n",
    "\n",
    "        print(f\"   ... 还有 {len(ids) - 20} 个（完整列表见下方保存的 JSON 文件）\")\n",
    "\n",
    "    print()\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "8130e280",
   "metadata": {},
   "source": [
    "上面只预览了每类前 20 个。因为总数有上万个场景，全部打印在屏幕上会很长，所以下面这个单元会把**完整清单**写成一个 JSON 文件，你可以随时打开查看或在其他脚本里 `import` 使用。\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "6d7fe4fe",
   "metadata": {},
