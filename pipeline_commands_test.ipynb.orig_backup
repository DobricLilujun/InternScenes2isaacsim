      "文件大小: 238.1 KB\n",
      "\n",
      "  scannet: 1513 个场景\n",
      "  3rscan: 1334 个场景\n",
      "  arkitscenes: 5040 个场景\n",
      "  matterport3d: 1696 个场景\n",
      "  总计: 9583 个场景\n"
     ]
    }
   ],
   "source": [
    "import json\n",
    "\n",
    "out_path = os.path.join(PROJ, \"output\", \"scene_inventory.json\")\n",
    "\n",
    "os.makedirs(os.path.dirname(out_path), exist_ok=True)\n",
    "\n",
    "with open(out_path, \"w\", encoding=\"utf-8\") as f:\n",
    "\n",
    "    json.dump(inventory, f, ensure_ascii=False, indent=1)\n",
    "\n",
    "print(f\"完整场景清单已保存: {out_path}\")\n",
    "print(f\"文件大小: {os.path.getsize(out_path) / 1024:.1f} KB\")\n",
    "\n",
    "print()\n",
    "for name in DATASETS:\n",
    "    print(f\"  {name}: {len(inventory[name])} 个场景\")\n",
    "\n",
    "print(f\"  总计: {sum(len(v) for v in inventory.values())} 个场景\")\n"
   ]
  },
