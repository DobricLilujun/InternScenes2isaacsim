      "[OK] scripts/glb_to_usd.py: /home/ubadmin/projects/InternScenes2isaacsim/scripts/glb_to_usd.py\n",
      "[OK] scripts/usd_all.sh: /home/ubadmin/projects/InternScenes2isaacsim/scripts/usd_all.sh\n",
